{
  "name": "markazify",
  "version": "1.0.0",
  "private": true,
  "description": "Markaz monorepo — Payload CMS admin, Next.js storefront, and shared core packages.",
  "engines": {
    "node": ">=18.20.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:admin": "turbo run dev --filter=@markaz/admin-backend-next",
    "dev:storefront": "turbo run dev --filter=@markaz/storefront",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev:seller-portal": "turbo run dev --filter=@markaz/seller-portal",
    "dev:seller-backend": "turbo run dev --filter=@markaz/seller-backend",
    "typecheck": "turbo run type-check --continue",
    "type-check:all": "pnpm -r run type-check",
    "test": "pnpm -r --if-present run test",
    "dev:admin-frontend": "pnpm --filter @markaz/admin-frontend dev"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "mongoose": "^8.24.1"
  }
}

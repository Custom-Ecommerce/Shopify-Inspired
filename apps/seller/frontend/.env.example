# Seller frontend (seller portal / dashboard, Next.js, port 3002). Copy to .env and fill in. Never commit real values.

# Base URL of the seller backend; the dashboard BFF and server pages call it.
SELLER_BACKEND_API_URL=http://localhost:4001
# This portal's own public URL (fallback origin for Stripe return links).
SELLER_PORTAL_URL=http://localhost:3002
# Optional cookie domain for the session cookie (e.g. .markazify.com); leave empty on localhost.
COOKIE_DOMAIN=
# "true" sends a seller with exactly one store straight to that store's dashboard.
MULTISTORE_IMPLICIT_DEFAULT=
# Storefront root domain shown in the sidebar store links (no scheme), e.g. localhost:3000.
NEXT_PUBLIC_ROOT_DOMAIN_URL=localhost:3000

# Sprint 4: no email or commission variable is read here; emails are sent by the backends (see SETUP.md).

# Seller app (Expo). Copy to .env in this folder. EXPO_PUBLIC_ values are built into the app and anyone can read them: never put a secret here.

# The seller backend. Leave empty with Expo Go on the same Wi-Fi: the app then uses http://<your computer>:4001.
# A release build needs an https address.
EXPO_PUBLIC_API_URL=

# The seller website, for the "Contact support" link. Empty with Expo Go: http://<your computer>:3002. A release build needs https.
EXPO_PUBLIC_SELLER_PORTAL_URL=

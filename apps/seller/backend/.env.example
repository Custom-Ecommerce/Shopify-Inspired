# Signs the short-lived token that lets the tab which placed an order read it back without a phone number. 32 characters or
# more. Unset: the confirmation page asks for the order number and phone instead. Never log it.
ORDER_ACCESS_SECRET=

# Card payments for storefront orders (D-082). Card is offered only when both are set and STOREFRONT_URL is a valid address.
# Never log these. The webhook secret is the one Stripe shows for the endpoint /api/webhooks/stripe-orders, which listens for
# checkout.session.completed, checkout.session.expired and checkout.session.async_payment_failed.
STRIPE_SECRET_KEY=
STRIPE_ORDER_WEBHOOK_SECRET=
# The storefront's address. Shoppers return from Stripe to <store slug>.<this host>/orders/<order number>.
STOREFRONT_URL=

# The storefront signs each shopper's address with this secret, and a valid signature is believed first. Set the same value
# (32 characters or more) on the storefront. With it set, requests that come through the storefront need neither setting below.
CLIENT_ADDRESS_SIGNING_SECRET=

# Who is the client for anything not signed? Used by the storefront API rate limits (D-081). Set at most one of the two. With neither, the
# address of the connection is used, which behind the storefront's BFF is the storefront server: every shopper would
# then share one limit. x-forwarded-for is never trusted without this setting.

# How many proxies in front of this backend append to x-forwarded-for. The storefront's BFF counts as one: it sends the
# shopper's address as x-forwarded-for. So 1 when the storefront connects straight to this backend, 2 with a load
# balancer between them. Only safe when clients cannot reach this backend except through those proxies.
TRUSTED_PROXY_HOPS=

# Or: one header that the proxy in front of this backend always sets itself and never passes through from a client.
# x-forwarded-for is not accepted here.
TRUSTED_CLIENT_IP_HEADER=

# --- Core settings the code reads (added in Sprint 4 SB-1 so every variable is listed) ---
# MongoDB connection string of the seller database. Use a throwaway database for local work.
SELLER_MONGODB_URI=
# Signs seller session tokens (HS256, audience seller-backend). 32 characters or more.
SELLER_AUTH_SECRET=
# Maximum stores per seller (default 3).
SELLER_MAX_STORES=
# Status of a new store. Verification-only shortcut: leave EMPTY in production (CO-26; removed in EP-04.US06).
SELLER_NEW_STORE_STATUS=
# Signs the 24-hour storefront preview links (32 characters or more).
PREVIEW_TOKEN_SECRET=
# Shared with the storefront's /api/revalidate so a save purges the storefront cache (EP-09).
REVALIDATE_SECRET=
# Bearer secret the daily scheduler sends to /api/internal/retention.
RETENTION_CRON_SECRET=
# Verifies signed moderation calls from the admin backend; the same value as there.
MODERATION_API_SECRET=
# Current sync signing key id; the same pair as on the admin backend.
SYNC_KEY_ID_CURRENT=
# Current sync signing secret (32 characters or more).
SYNC_SECRET_CURRENT=
# Previous sync key id, only while rotating keys.
SYNC_KEY_ID_PREVIOUS=
# Previous sync secret, only while rotating keys.
SYNC_SECRET_PREVIOUS=
# Base URL of the admin backend, used by the billing bridge.
ADMIN_BACKEND_API_URL=http://localhost:4010
# Seller portal URL used by the old billing onboarding return links (Stripe Connect, removed in SB-4, D-088).
SELLER_APP_URL=http://localhost:3002
# Cloudinary cloud name for media uploads.
CLOUDINARY_CLOUD_NAME=
# Cloudinary API key.
CLOUDINARY_API_KEY=
# Cloudinary API secret. Never log it.
CLOUDINARY_API_SECRET=
# Cloudinary folder for uploads (default markaz).
CLOUDINARY_FOLDER=

# --- Sprint 4: email and notifications (D-091) ---
# Email provider: resend | smtp | log. Empty or log keeps messages in the outbox with status skipped (development).
EMAIL_PROVIDER=log
# Sender address for every email, e.g. "Markazify <no-reply@example.com>" (a domain verified with the provider).
EMAIL_FROM=
# Resend API key, used when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# SMTP host, used when EMAIL_PROVIDER=smtp.
SMTP_HOST=
# SMTP port, usually 587 (STARTTLS) or 465 (TLS).
SMTP_PORT=587
# SMTP user name.
SMTP_USER=
# SMTP password.
SMTP_PASS=
# Bearer secret the scheduler sends to the internal outbox retry route (32 characters or more).
OUTBOX_CRON_SECRET=
# Seller portal base URL used in links inside emails (verify email, password reset, order alerts).
APP_BASE_URL_SELLER=http://localhost:3002

# --- Sprint 4: commission (D-089) ---
# Platform default commission percent: placeholder 5, the owner sets the real value before launch (A-019).
PLATFORM_DEFAULT_COMMISSION_PERCENT=5

# Admin frontend (operator console, Next.js, port 4020). Copy to .env and fill in. Never commit real values.

# Base URL of the admin backend; every console call goes through this app's server to it.
ADMIN_BACKEND_API_URL=http://localhost:4010

# Sprint 4: no email or commission variable is read here; emails are sent by the backends (see SETUP.md).

# --- Sprint 4 (A3): the browser's address for the backend's per-IP login and reset limits ---
# Signs the browser's address for the backend; the same value (32+ characters) as CLIENT_ADDRESS_SIGNING_SECRET there.
CLIENT_ADDRESS_SIGNING_SECRET=
# How many proxies in front of this app append to x-forwarded-for (Vercel: 1). Set this or the header below.
TRUSTED_PROXY_HOPS=
# Or: one header the proxy in front of this app always sets itself (never x-forwarded-for).
TRUSTED_CLIENT_IP_HEADER=

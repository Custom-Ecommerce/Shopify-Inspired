# Admin backend (Next.js, port 4010). Copy to .env and fill in. Never commit real values.

# --- Database and sessions ---
# MongoDB connection string of the admin (platform) database. Use a throwaway database for local work.
MONGODB_URI=
# Signs admin session tokens (HS256, audience admin-backend). 32 characters or more.
ADMIN_AUTH_SECRET=

# --- Admin and seller backend link (sync, moderation) ---
# Base URL of the seller backend, used by moderation calls (SELLER_BACKEND_URL wins when both are set).
SELLER_BACKEND_API_URL=http://localhost:4001
# Optional override of SELLER_BACKEND_API_URL for the moderation client.
SELLER_BACKEND_URL=
# Signs moderation calls to the seller backend; the same value as MODERATION_API_SECRET on the seller backend.
MODERATION_API_SECRET=
# Current sync signing key id; the same pair must be set on the seller backend.
SYNC_KEY_ID_CURRENT=
# Current sync signing secret (32 characters or more).
SYNC_SECRET_CURRENT=
# Previous sync key id, kept only while rotating keys (leave empty otherwise).
SYNC_KEY_ID_PREVIOUS=
# Previous sync secret, kept only while rotating keys (leave empty otherwise).
SYNC_SECRET_PREVIOUS=
# Older single-secret check on the internal sync routes (_guard.ts).
SYNC_HMAC_SECRET=
# Bearer secret the scheduler sends to /api/internal/sync/drain (vercel.json cron).
CRON_SECRET=

# --- Stripe (platform account; subscriptions and the older admin-side webhook) ---
# Platform Stripe secret key (sk_test_... for development). Never log it.
STRIPE_SECRET_KEY=
# Signing secret of the admin webhook endpoint /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=

# --- Sprint 4: email and notifications (D-091) ---
# Email provider: resend | smtp | log. Empty or log keeps messages in the outbox with status skipped (development).
EMAIL_PROVIDER=log
# Sender address for every email, e.g. "Markazify <no-reply@example.com>" (a domain verified with the provider).
EMAIL_FROM=
# Resend API key, used when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# SMTP host, used when EMAIL_PROVIDER=smtp.
SMTP_HOST=
# SMTP port, usually 587 (STARTTLS) or 465 (TLS).
SMTP_PORT=587
# SMTP user name.
SMTP_USER=
# SMTP password.
SMTP_PASS=
# Bearer secret the scheduler sends to the internal outbox retry route (32 characters or more).
OUTBOX_CRON_SECRET=
# Seller portal base URL used in links inside emails (payouts, password reset).
APP_BASE_URL_SELLER=http://localhost:3002

# --- Sprint 4: commission (D-089) ---
# Platform default commission percent: placeholder 5, the owner sets the real value before launch (A-019).
PLATFORM_DEFAULT_COMMISSION_PERCENT=5

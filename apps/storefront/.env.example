# Who is the shopper? The BFF sends this address to the seller backend for its per-client rate limits (D-081). Set at
# most one of the two. With neither, the address of the connection is used, which behind a proxy is the proxy.
# x-forwarded-for is never trusted without this setting.

# How many proxies in front of the storefront append to x-forwarded-for (usually 1).
TRUSTED_PROXY_HOPS=

# Or: one header that the proxy in front of the storefront always sets itself and never passes through from a client.
# x-forwarded-for is not accepted here.
TRUSTED_CLIENT_IP_HEADER=

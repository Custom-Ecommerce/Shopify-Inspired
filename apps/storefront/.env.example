# Signs the shopper's address for the seller backend, so a direct call to the backend cannot choose its own. The same value
# (32 characters or more) as on the backend.
CLIENT_ADDRESS_SIGNING_SECRET=

# Who is the shopper? The BFF sends this address to the seller backend for its per-client rate limits (D-081). Set at
# most one of the two. With neither, the address of the connection is used, which behind a proxy is the proxy.
# x-forwarded-for is never trusted without this setting.

# How many proxies in front of the storefront append to x-forwarded-for (usually 1).
TRUSTED_PROXY_HOPS=

# Or: one header that the proxy in front of the storefront always sets itself and never passes through from a client.
# x-forwarded-for is not accepted here.
TRUSTED_CLIENT_IP_HEADER=

# --- Other settings the code reads (added in Sprint 4 SB-1 so every variable is listed) ---
# Base URL of the seller backend (storefront API).
SELLER_BACKEND_API_URL=http://localhost:4001
# Where storefront data comes from: remote (seller backend) or mock (fixtures; refused in production).
STOREFRONT_DATA_SOURCE=remote
# Remote transport mode: empty means http; "stub" skips the seller backend (builds without a backend).
STOREFRONT_REMOTE_MODE=
# Root domain that store subdomains hang from (default markazify.com).
ROOT_DOMAIN=
# Comma-separated hostnames that serve the platform site rather than a store (default 127.0.0.1,[::1]).
PLATFORM_HOSTNAMES=
# Seller portal URL for links and redirects (default http://localhost:3002).
SELLER_PORTAL_URL=http://localhost:3002
# Same value as REVALIDATE_SECRET on the seller backend; protects /api/revalidate.
REVALIDATE_SECRET=
# "1" shows the Stiletto data-source badges in production (development aid).
NEXT_PUBLIC_THEME_DATA_BADGES=
